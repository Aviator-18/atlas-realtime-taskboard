# Database configuration
DB_URL=jdbc:postgresql://localhost:5432/atlas
DB_USER=atlas
DB_PASSWORD=atlas

# Security
ATLAS_JWT_SECRET=dev-secret-change-in-production-must-be-at-least-32-chars-long
ATLAS_CORS_ORIGINS=http://localhost:5173

# LLM estimation provider (empty values trigger deterministic fallback)
ATLAS_LLM_BASE_URL=
ATLAS_LLM_MODEL=
ATLAS_LLM_API_KEY=
ATLAS_LLM_TIMEOUT_MS=5000

# Frontend endpoints
VITE_API_BASE_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080/ws
